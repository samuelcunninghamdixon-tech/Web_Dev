# Core app
APP_ENV=development
PROJECT_NAME=local-ai-agency

# PostgreSQL
POSTGRES_DB=agency
POSTGRES_USER=agency
POSTGRES_PASSWORD=agency
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://agency:agency@postgres:5432/agency

# n8n
N8N_HOST=http://localhost:5678
N8N_WEBHOOK_URL=http://n8n:5678/webhook

# Ollama / local LLMs
OLLAMA_BASE_URL=http://ollama:11434
VISION_MODEL=qwen2-vl:7b
CODER_MODEL=qwen2.5-coder:32b
TEXT_MODEL=qwen2.5:32b

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace-me
SLACK_SIGNING_SECRET=replace-me

# GitHub Pages
GITHUB_TOKEN=replace-me
GITHUB_OWNER=replace-me
GITHUB_REPO=replace-me

# SMTP / Resend
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me

# Shared volumes
SHARED_ROOT=/shared
