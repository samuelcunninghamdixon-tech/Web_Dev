{
  "name": "Discovery Workflow",
  "nodes": [
    {
      "id": "trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "parameters": {
        "interval": [
          {
            "field": "hours",
            "hours": 12
          }
        ]
      }
    },
    {
      "id": "prospect",
      "name": "Prepare Prospect",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 300],
      "parameters": {
        "values": {
          "string": [
            {"name": "prospect_id", "value": "={{ $json.prospect_id || 'local-prospect' }}"},
            {"name": "url", "value": "={{ $json.url || 'https://example.org' }}"},
            {"name": "correlation_id", "value": "={{ $json.correlation_id || $execution.id }}"}
          ]
        }
      }
    },
    {
      "id": "scrape",
      "name": "Scrape Website",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [720, 300],
      "parameters": {
        "url": "http://scraper-service:8000/scrape",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {"parameters": [
          {"name": "X-Correlation-ID", "value": "={{ $json.correlation_id }}"},
          {"name": "X-Idempotency-Key", "value": "={{ $json.correlation_id + ':scrape:' + $json.prospect_id }}"}
        ]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({url: $json.url, prospect_id: $json.prospect_id, screenshot: {enabled: true, full_page: true}}) }}",
        "options": {"timeout": 30000},
        "responseFormat": "json"
      },
      "credentials": {
        "httpHeaderAuth": {"id": "INTERNAL_API_CREDENTIAL_ID", "name": "agency-internal-api"}
      }
    },
    {
      "id": "audit",
      "name": "Audit Workflow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [960, 300],
      "parameters": {
        "url": "http://agent-service:8000/api/audit",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {"parameters": [
          {"name": "X-Correlation-ID", "value": "={{ $json.correlation_id || $execution.id }}"},
          {"name": "X-Idempotency-Key", "value": "={{ ($json.correlation_id || $execution.id) + ':audit:' + $json.prospect_id }}"}
        ]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({prospect_id: $json.prospect_id, url: $json.url, screenshot_path: $json.screenshot_path || null, assets: $json.assets || []}) }}",
        "options": {"timeout": 30000},
        "responseFormat": "json"
      },
      "credentials": {
        "httpHeaderAuth": {"id": "INTERNAL_API_CREDENTIAL_ID", "name": "agency-internal-api"}
      }
    }
  ],
  "connections": {
    "trigger": {
      "main": [
        [
          {
            "node": "prospect",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "prospect": {
      "main": [
        [
          {
            "node": "scrape",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "scrape": {
      "main": [
        [
          {
            "node": "audit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
